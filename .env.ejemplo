# Copia este archivo como .env y rellena lo que uses. .env no se sube a GitHub.
# Clave de Brave Search (opcional: sin ella Jarvis no busca en la web). Crea la tuya en https://brave.com/search/api/
BRAVE_API_KEY=
# Carpeta que contiene los proyectos CAD (opcional; por defecto, Documents\Proyectos_SolidEdge)
# JARVIS_CARDAN_RAIZ=C:\ruta\a\mis\proyectos
# Instalación de Solid Edge, solo si Jarvis no la detecta sola (la carpeta con Program, Preferences y Template)
# JARVIS_SE_RAIZ=C:\Program Files\Siemens\Solid Edge 2026
